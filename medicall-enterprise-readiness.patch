new file mode 100644
index 0000000..4258456
--- /dev/null
+++ b/src/components/ErrorScreen.tsx
@@ -0,0 +1,19 @@
+import { useRouteError } from 'react-router-dom'
+import { BRAND, EMERGENCY } from '@/config/app'
+
+/** Pantalla de respaldo: evita la pantalla en blanco ante cualquier error de render o de carga de ruta. */
+export function ErrorScreen() {
+  const error = useRouteError()
+  if (import.meta.env.DEV) console.error(error)
+  return (
+    <main role="alert" className="mx-auto flex min-h-dvh max-w-md flex-col items-center justify-center gap-4 px-6 text-center">
+      <h1 className="text-3xl font-bold">Algo salió mal</h1>
+      <p className="text-muted">No pudimos mostrar esta pantalla. Tus datos no se perdieron. Si estás en medio de una consulta, vuelve a ingresar desde el inicio.</p>
+      <div className="flex flex-wrap justify-center gap-3">
+        <button type="button" onClick={() => window.location.reload()} className="rounded-full bg-primary px-5 py-2.5 font-medium text-primary-foreground">Reintentar</button>
+        <a href="/app/" className="rounded-full border border-border px-5 py-2.5 font-medium">Ir al inicio</a>
+      </div>
+      <p className="text-sm text-muted">¿Es una emergencia? Llama al <a className="underline" href={`tel:${EMERGENCY.number}`}>{EMERGENCY.number} ({EMERGENCY.label})</a>. {BRAND.name} no reemplaza servicios de emergencia.</p>
+    </main>
+  )
+}

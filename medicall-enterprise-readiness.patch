diff --git a/.env.example b/.env.example
new file mode 100644
index 0000000..bd1ce18
--- /dev/null
+++ b/.env.example
@@ -0,0 +1,8 @@
+# Copia a .env.local (desarrollo) o configúralo en Vercel (producción).
+VITE_BRAND_NAME=MediCall
+VITE_SUPPORT_EMAIL=soporte@medicall.pe
+VITE_LEGAL_ENTITY=Razón social S.A.C. (RUC 20XXXXXXXXX)
+VITE_EMERGENCY_NUMBER=106
+VITE_EMERGENCY_LABEL=SAMU
+# "false" en producción: oculta herramientas de demostración.
+VITE_DEMO_MODE=true
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
new file mode 100644
index 0000000..4c2dfc2
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,28 @@
+name: CI
+on:
+  push: { branches: [main] }
+  pull_request:
+jobs:
+  check:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with: { node-version: 22, cache: npm }
+      - run: npm ci
+      - run: npm run check
+      - run: npm run build
+      - run: npm audit --omit=dev --audit-level=high
+  e2e:
+    runs-on: ubuntu-latest
+    needs: check
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with: { node-version: 22, cache: npm }
+      - run: npm ci
+      - run: npx playwright install --with-deps chromium
+      - run: npm run test:e2e
+      - uses: actions/upload-artifact@v4
+        if: failure()
+        with: { name: playwright-traces, path: test-results }
diff --git a/README.md b/README.md
index 93d5483..a0c0f77 100644
--- a/README.md
+++ b/README.md
@@ -31,6 +31,17 @@ Sidebar + ⌘K en escritorio, tab bar en móvil; flujos enfocados (triaje, búsq
 La imagen del hero (`public/images/hero-doctors.jpg`) es de baja resolución (678 px): conviene reemplazarla por una
 versión grande y con licencia clara antes de producción.
 
-## Pendiente
+## Configuración por cliente (marca blanca)
+Copia `.env.example` a `.env.local`. Marca, correo de soporte, razón social, número de emergencia y `VITE_DEMO_MODE`
+se definen por variables de entorno. En producción usar `VITE_DEMO_MODE=false`.
+Los textos legales (`/app/legal/*`) son **borrador** y deben ser aprobados por el área legal del cliente.
+`vercel.json` incluye CSP, HSTS y Permissions-Policy: si el backend vive en otro dominio, agregarlo a `connect-src`.
+
+## Pendiente antes de producción con un cliente grande
+Autenticación real (hoy "Cerrar sesión" es un stub), backend que implemente `MediCallApi` (hoy todo es mock en `localStorage`,
+que **no** debe contener datos de pacientes reales), video real, pagos, auditoría de accesos a historia clínica,
+validación clínica del triaje, imágenes propias de la landing (hoy en Cloudinary de terceros) y revisión legal.
+
+## Pendiente de producto
 Video real (LiveKit/Daily), pagos, push notifications, panel completo del médico (cola, ganancias), mapa de clínicas,
 reseñas reales tras cada consulta, backend de verificación de colegiatura.

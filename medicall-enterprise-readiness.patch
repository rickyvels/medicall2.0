@@ -0,0 +1,14 @@
+import { beforeEach, describe, expect, it } from 'vitest'
+import { mockApi } from './client'
+import { resetDb } from './db'
+
+describe('consentimiento informado', () => {
+  beforeEach(() => resetDb())
+
+  it('se guarda con versión y fecha al completar el onboarding', async () => {
+    const acceptedAt = new Date().toISOString()
+    const p = await mockApi.profile.completeOnboarding({ firstName: 'Ana', consent: { version: 'v-test', acceptedAt } })
+    expect(p.onboarded).toBe(true)
+    expect(p.consent).toEqual({ version: 'v-test', acceptedAt })
+  })
+})

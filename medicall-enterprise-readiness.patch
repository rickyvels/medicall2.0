@@ -0,0 +1,24 @@
+/**
+ * Configuración de la instalación (marca blanca, modo demo, números de emergencia).
+ * Todo se define por variables de entorno `VITE_*` para que cada cliente (clínica)
+ * pueda desplegar su propia versión sin tocar el código. Ver `.env.example`.
+ */
+const env = import.meta.env
+

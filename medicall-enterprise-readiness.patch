@@ -0,0 +1,50 @@
+import { Link, Navigate, useParams } from 'react-router-dom'
+import { BRAND, EMERGENCY, LEGAL_VERSION } from '@/config/app'
+
+type Doc = { title: string; sections: { h: string; p: string }[] }
+
+const docs: Record<string, Doc> = {
+  consentimiento: {
+    title: 'Consentimiento informado de telesalud',
+    sections: [
+      { h: 'Qué es una teleconsulta', p: 'Es una atención de salud a distancia por videollamada con un profesional colegiado. Tiene limitaciones: el profesional no puede realizar examen físico, y puede indicarte que acudas a una atención presencial.' },
+      { h: 'No es un servicio de emergencias', p: `Ante dolor en el pecho, dificultad para respirar, pérdida de conciencia, sangrado abundante u otra urgencia, llama al ${EMERGENCY.number} (${EMERGENCY.label}) o acude a la emergencia más cercana. No uses la plataforma para estos casos.` },
+      { h: 'Tu aceptación', p: 'Declaras que la información que brindas es veraz, que entiendes las limitaciones de la atención a distancia y que puedes retirar tu consentimiento en cualquier momento escribiendo a ' + BRAND.supportEmail + '.' },
+    ],
+  },
+  privacidad: {
+    title: 'Política de privacidad',
+    sections: [
+      { h: 'Responsable del tratamiento', p: `${BRAND.legalEntity}. Contacto: ${BRAND.supportEmail}.` },
+      { h: 'Datos que tratamos', p: 'Datos de identificación y contacto, y datos de salud (síntomas, alergias, historial de consultas, recetas). Los datos de salud son datos sensibles según la Ley N.° 29733, de Protección de Datos Personales.' },
+      { h: 'Finalidad', p: 'Brindarte atención de salud, agendar y gestionar tus consultas, emitir recetas y cumplir obligaciones legales. No vendemos tus datos.' },
+      { h: 'Tus derechos (ARCO)', p: `Puedes ejercer tus derechos de acceso, rectificación, cancelación y oposición escribiendo a ${BRAND.supportEmail}.` },
+    ],
+  },
+  terminos: {
+    title: 'Términos y condiciones',
+    sections: [
+      { h: 'Naturaleza del servicio', p: `${BRAND.name} conecta pacientes con profesionales de la salud colegiados. La responsabilidad clínica de cada atención corresponde al profesional que la brinda.` },
+      { h: 'Uso adecuado', p: 'No compartas tu cuenta, no grabes la consulta sin autorización del profesional y no uses el servicio para emergencias.' },
+    ],
+  },
+}
+
+/** Textos legales en BORRADOR: deben ser revisados y aprobados por el área legal del cliente antes de producción. */
+export default function LegalPage() {
+  const { doc = '' } = useParams()
+  const d = docs[doc]
+  if (!d) return <Navigate to="/" replace />
+  return (
+    <main className="mx-auto max-w-2xl space-y-6 px-5 py-10">
+      <p role="note" className="rounded-2xl bg-surface-2 p-3 text-sm text-muted">Borrador pendiente de validación legal · versión {LEGAL_VERSION}</p>
+      <h1 className="text-3xl font-bold">{d.title}</h1>
+      {d.sections.map((s) => (
+        <section key={s.h} className="space-y-1.5"><h2 className="text-lg font-semibold">{s.h}</h2><p className="text-muted">{s.p}</p></section>
+      ))}
+      <nav className="flex flex-wrap gap-4 text-sm underline">
+        {Object.entries(docs).filter(([k]) => k !== doc).map(([k, v]) => <Link key={k} to={`/legal/${k}`}>{v.title}</Link>)}
+      </nav>
+    </main>
+  )
+}
